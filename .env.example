# DevWeb Configuration
# Copy this file to .env and update the values

# Model Paths
MODEL_PATH=/mnt/shared-storage-user/medeval-share/model/Qwen2.5-7B-Instruct
JUDGE_MODEL_PATH=${MODEL_PATH}
AGENT_MODEL_PATH=${MODEL_PATH}
ENVIRONMENT_MODEL_PATH=${MODEL_PATH}

# Training Configuration
MAX_TURNS=3
BATCH_SIZE=32
LEARNING_RATE=1e-5
NUM_EPOCHS=3
GROUP_SIZE=4

# Storage Configuration
STORAGE_PATH=./data/trajectories.jsonl
LOG_PATH=./logs/
CHECKPOINT_PATH=./checkpoints/

# LLM Configuration
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=512

# Environment Configuration
ENABLE_LOGGING=true
DEBUG_MODE=false
SAVE_TRAJECTORIES=true